override": 1}], "stimuli": [{"id": 0, "type": "welcome", "contents": [{}], "template_override": 1, "_data": []}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn3le01ob05re2img05.jpg"}, {"text": "<span class = \"strong\">Vanessa</span>: Thanks for dinner, Peter.<br/>\n<span class = \"strong\">Peter</span>: I'm happy you like Thai Basil. <br/>\n<span class = \"strong\">Vanessa</span>: I love to discover food from around the world. <br/>", "id": 1, "time": "10", "image": "engenn3le01ob05re2img05.jpg"}, {"text": "<span class = \"strong\">Peter</span>: Yes. Cambridge always has a lot to offer.<br/>\n<span class = \"strong\">Vanessa</span>: Yeah. I guess I should try new things more often.", "id": 2, "time": "6000", "image": "engenn3le01ob05re2img05.jpg"}, {"text": "<span class = \"strong\">Peter</span>: Why do you say that?<br/>\n<span class = \"strong\">Vanessa</span>: I always order the same things.<br/>", "id": 3, "time": "12000", "image": "engenn3le01ob05re2img05.jpg"}, {"text": "<span class = \"strong\">Peter</span>: Me too sometimes. For example, I usually have a burger and fries at the Willow Diner.<br/>\n<span class = \"strong\">Vanessa</span>: Those fries are so good! I love their strawberry milkshakes too.", "id": 4, "time": "15500", "image": "engenn3le01ob05re2img03.jpg"}, {"text": "<span class = \"strong\">Peter</span>: I rarely drink milkshakes. I'd rather have orange juice, or lemonade.<br/>\n<span class = \"strong\">Vanessa</span>: Those are good too, especially with scrambled eggs.<br/>\n<span class = \"strong\">Peter</span>: We should have breakfast there this weekend!<br/>\n<span class = \"strong\">Vanessa</span>: I would prefer to go next week. I don't want to get fat!", "id": 5, "time": "26000", "image": "engenn3le01ob05re2img02.jpg"}], "audiosrc": "engenn3le01ob05re2aud01", "coverimg": "engenn3le01ob05re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}