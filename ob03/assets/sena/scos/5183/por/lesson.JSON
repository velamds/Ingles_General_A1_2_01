\"rows\":5,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Subject\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Simple Present Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Object\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"like\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"coconut rice.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"She \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"goes \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"shopping.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"eats\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"breakfast every day.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"are\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"welcome.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Go online and research on a new restaurant in your neighborhood."}, {"type": "text", "content": "Write a dialogue."}, {"type": "text", "content": "Describe the food to your partner."}, {"type": "text", "content": "Invite your partner. Remember: it's your treat!"}, {"type": "text", "content": "Thank your partner for dinner."}, {"type": "text", "content": "Exchange roles."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I use expressions to thank people and respond to thanks."}, {"type": "text", "content": "I write a dialogue on taking a friend out to dinner."}, {"type": "text", "content": "I talk about food and drinks."}]}], "labs": [{"stimuli": [{"_data": [], "id": 0, "type": "welcome", "contents": [{}], "template_override": 1}, {"id": 2, "type": "audio", "title": "", "_