{"_data": [{"contents": [{"content": "At the Restaurant", "type": "lesson_name"}, {"content": "Thanks! Next Time Is on Me", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "scholar > World of Food > Eating in Town", "type": "origin"}, {"content": 1, "type": "lesson"}, {"content": "A1.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about food, eating and meals in communicative situations.", "type": "primary"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_1"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_2"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_3"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_4"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_5"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_6"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_7"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": " Thanking People and Responding to Thanks", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "In polite conversations, it is important to thank people when they do something for you or help you.", "type": "text"}, {"content": "You respond to thanks with expression like <span class = \"italic\">You're welcome</span> or <span class = \"italic\">My pleasure</span>.", "type": "text"}, {"content": "Here are some useful expressions:", "type": "text"}, {"content": "{\"rows\":3,\"columns\":3,\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">Thanking People</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">Responding to Thanks</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">Formal</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">You shouldn't have!</span><br/><span class = \\\"italic\\\">This is really kind/sweet of you!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">My pleasure.</span><br/><span class = \\\"italic\\\">You're very welcome.</span><br/><span class = \\\"italic\\\">Don't mention it!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">Informal</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">Thanks!</span><br/><span class = \\\"italic\\\">Cheers!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">Sure. </span><br/><span class = \\\"italic\\\">No problem.</span><br/><span class = \\\"italic\\\">No worries.</span><br/><span class = \\\"italic\\\">It's nothing.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "<span class = \"strong\">Ann</span>: This is a nice surprise!<br/><span class = \"strong\">Bob</span>: My pleasure. I'm glad you like it.", "type": "example"}, {"content": "<span class = \"strong\">Allie</span>: Hey! Thanks for the meal!<br/><span class = \"strong\">Billy</span>: Sure! No problem!", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "to die for", "type": "name"}, {"content": "delicious; very good to eat", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: This pudding is to die for!", "type": "example"}, {"content": "engenn3le01ob03aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use in a conversation about food.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "coconut", "type": "name"}, {"content": "a hard, brown tropical fruit", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I love coconut juice!", "type": "example"}, {"content": "engenn3le01ob03aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "rice", "type": "name"}, {"content": "a white cereal grain, popular in Asian cuisine", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I love green curry and coconut rice.", "type": "example"}, {"content": "engenn3le01ob03aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "I'm so full!", "type": "name"}, {"content": "too much to eat", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I can't eat anymore. I'm so full!", "type": "example"}, {"content": "engenn3le01ob03aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "My treat!", "type": "name"}, {"content": "when someone offers to pay for a meal", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Let's go eat at Thai Basil. My treat!", "type": "example"}, {"content": "engenn3le01ob03aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "My pleasure!", "type": "name"}, {"content": "You're welcome!", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: \" Thank you for dinner!\" - \"My pleasure!\"", "type": "example"}, {"content": "engenn3le01ob03aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "You shouldn't have!", "type": "name"}, {"content": "thank you very much", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: That's very sweet of you. You shouldn't have!", "type": "example"}, {"content": "engenn3le01ob03aud08", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "It's on me!", "type": "name"}, {"content": "it's my turn to pay", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Thanks for dinner. Next time it's on me!", "type": "example"}, {"content": "engenn3le01ob03aud05", "type": "audio"}], "type": "target_word"}, {"content": "engenn3le01ob03re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "The Simple Present Tense", "type": "heading"}, {"content": "You use the Simple Present tense to talk about actions in the present or actions that happen on a regular basis.", "type": "describer"}, {"content": "I buy food at the grocery store.", "type": "example"}, {"content": "{\"rows\":5,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Subject\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Simple Present Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Object\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"like\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"coconut rice.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"She \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"goes \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"shopping.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"eats\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"breakfast every day.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"are\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"welcome.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "I like the coconut rice.", "type": "example"}, {"content": "You speak English.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Go online and research a new restaurant in your neighborhood.", "type": "text"}, {"content": "Write a dialogue.", "type": "text"}, {"content": "Describe the food to your partner.", "type": "text"}, {"content": "Invite your partner. Remember: it's your treat!", "type": "text"}, {"content": "Thank your partner for dinner.", "type": "text"}, {"content": "Exchange roles.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I use expressions to thank people and respond to thanks.", "type": "text"}, {"content": "I write a dialogue on taking a friend out to dinner.", "type": "text"}, {"content": "I talk about food and drinks.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn3le01ob03re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn3le01ob03re2img05.jpg", "time": "100", "id": 1, "text": "<span class = \"strong\">Peter</span>: Do you like the restaurant?<br/>\n<span class = \"strong\">Vanessa</span>: Yes! Thank you for the suggestion.<br/>\n<span class = \"strong\">Peter</span>: You're very welcome. What's your favorite dish?<br/>\n<span class = \"strong\">Vanessa</span>: I love the green curry. It's to die for!<br/>\n<span class = \"strong\">Peter</span>: That's true. I like the coconut rice."}, {"image": "engenn3le01ob03re2img01.jpg", "time": "14500", "id": 2, "text": "<span class = \"strong\">Vanessa</span>: I really shouldn't eat so much! I'm so full.<br/>\n<span class = \"strong\">Peter</span>: Ha ha. Make room for dessert!<br/>\n<span class = \"strong\">Vanessa</span>: Oohh ... don't worry! I'd love some mango pudding!<br/>\n<span class = \"strong\">Peter</span>: I could order it for you!<br/>\n<span class = \"strong\">Vanessa</span>: Fantastic. I need to go the bathroom. Excuse me.<br/>\n<span class = \"strong\">Peter</span>: Sure."}, {"image": "engenn3le01ob03re2img06.jpg", "time": "32000", "id": 3, "text": "<span class = \"strong\">Vanessa</span>: Oh! The bill!<br/>\n<span class = \"strong\">Peter</span>: Don't worry. It's my treat.<br/>\n<span class = \"strong\">Vanessa</span>: You shouldn't have!  </br>\n<span class = \"strong\">Peter</span>: Don't mention it! My pleasure. <br/>\n<span class = \"strong\">Vanessa</span>: This is very sweet of you. Next time it's on me! <br/>"}], "audiosrc": "engenn3le01ob03re2aud01", "coverimg": "engenn3le01ob03re2img05.jpg"}, "type": "slideshow"}], "id": 2}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}, {"content": "I can make and respond to offers